# NexEdu Multi-Tenant ERP Environment Configuration
# Database Connection (SQLite for zero-config dev, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/nexedu_db?schema=public"

# Security & Sessions
JWT_SECRET="replace-with-a-very-long-random-secret-string"

# Application Settings
NEXT_PUBLIC_APP_NAME="NexEdu OS"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Kolkata"
NODE_ENV="development"
